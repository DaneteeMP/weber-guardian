# Copiar a .env y ajustar
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/weberguardian

# Identidad de desarrollo (cabecera X-Dev-User). Solo local: en un entorno
# compartido se deja en false porque invalida la autenticacion real.
DEV_AUTH_ENABLED=false

# Puerta de acceso HTTP Basic para la demo publica. Con ambos campos vacios la
# puerta queda desactivada (comportamiento por defecto en local). La contraseña
# debe ser ASCII: el frontend la codifica con btoa.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Orígenes permitidos por CORS, separados por comas. Debe incluir la URL publica
# del frontend; /health y los preflight OPTIONS nunca piden credenciales.
ALLOWED_ORIGINS=http://localhost:5173
